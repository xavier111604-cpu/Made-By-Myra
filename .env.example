# ─────────────────────────────────────────────────────────────
# Made by Myra — environment variables
# Copy to .env (local) and add the same keys in your host (e.g. Vercel → Settings → Environment Variables).
# Never commit real values. Variables starting with NEXT_PUBLIC_ are visible in the browser —
# never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used in emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
# Pooled connection string (e.g. Supabase "Transaction pooler", Neon pooled URL)
DATABASE_URL=
# Direct (non-pooled) connection used for migrations. If you have only one URL, use it for both.
DIRECT_DATABASE_URL=

# ── Authentication (NextAuth) ──
NEXTAUTH_URL=http://localhost:3000
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional Google sign-in (leave blank to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe payments ──
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# Set to true only after enabling Stripe Tax and adding your tax registrations in Stripe
STRIPE_AUTOMATIC_TAX=false
# Comma-separated ISO country codes you ship to
SHIPPING_COUNTRIES=US

# ── File storage (any S3-compatible provider: Supabase Storage, Cloudflare R2, AWS S3) ──
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for customer artwork, proofs and attachments (must NOT be public)
S3_PRIVATE_BUCKET=
# Public bucket for product photos, mockups and homepage images
S3_PUBLIC_BUCKET=
# Public base URL of the public bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_BASE_URL=
# true for Supabase Storage and MinIO
S3_FORCE_PATH_STYLE=false

# ── Email (Resend) ──
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Made by Myra <hello@yourdomain.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=
# Where new-order / proof / contact notifications go
OWNER_NOTIFICATION_EMAIL=
# Optional: Resend Audience ID to sync newsletter subscribers into
RESEND_AUDIENCE_ID=

# ── Optional AI design concepts (not implemented; see src/lib/ai/design-concepts.ts) ──
AI_DESIGN_PROVIDER=
